# OpenAI (required)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4

# OpenSandbox (when using --sandbox or sandbox-by-default)
# Domain of opensandbox-server (default: localhost:8080)
OPEN_SANDBOX_DOMAIN=localhost:8080
# API key - must match server's api_key in ~/.sandbox.toml (optional for local dev)
OPEN_SANDBOX_API_KEY=
# Docker image for sandbox (default: chemistry-ml:latest; build from docker/chemistry-ml.Dockerfile)
OPEN_SANDBOX_IMAGE=chemistry-ml:latest